    "@oslojs/encoding": "^1.1.0",
    "@prisma/client": "^6.11.1",
    "@types/nodemailer": "^6.4.17",
    "axios": "^1.12.2",
    "bson": "^6.10.4",
    "bullmq": "^5.58.5",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
