enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum AddressSource {
  REVERSE_GEOCODE
  MANUAL
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

model Address {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  addressType  AddressType
  address      String
  lat          Float?
  lng          Float?
  streetNumber String?
  houseFlatNo  String
  road         String
  city         String
  state        String
  country      String
  zipcode      String
  placeId      String?
  source       AddressSource

  primary Boolean @default(false)
  active  Boolean @default(true)

  orders Order[]

  customerProfileId String          @db.ObjectId
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  createdAt      DateTime        @default(now())
  returnRequests ReturnRequest[]
}

model CartItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quantity Int

  productVariantId  String?         @db.ObjectId
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id])
  productComboId    String?         @db.ObjectId
  productCombo      ProductCombo?   @relation(fields: [productComboId], references: [id])
  customerProfileId String          @db.ObjectId
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  createdAt DateTime @default(now())

  @@unique([customerProfileId, productVariantId, productComboId], name: "unique_cart_item")
}

model WishlistItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productVariantId  String?         @db.ObjectId
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id])
  productComboId    String?         @db.ObjectId
  productCombo      ProductCombo?   @relation(fields: [productComboId], references: [id])
  customerProfileId String          @db.ObjectId
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])

  createdAt DateTime @default(now())

  @@unique([customerProfileId, productVariantId, productComboId], name: "unique_wishlist_item")
}

model CustomerProfile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  wallet                        Float  @default(0)
  walletBufferForOnlinePayments Float  @default(0)
  gender                        Gender @default(PREFER_NOT_TO_SAY)
  age                           Int    @default(0)

  addresses  Address[]
  cart       CartItem[]
  wishlist   WishlistItem[]
  orders     Order[]
  reviews    Review[]
  walletLogs WalletLogs[]
}

enum WalletLogType {
  CREDIT
  DEBIT
}

model WalletLogs {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  amount            Float
  type              WalletLogType
  orderId           String?       @db.ObjectId
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            Boolean       @default(true)

  createdAt DateTime @default(now())

  customerProfileId String          @db.ObjectId
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
}
