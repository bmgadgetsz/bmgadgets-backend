model Warehouse {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  company           String
  title             String
  contactPersonName String
  email             String
  phone             String // use string to preserve country code formatting like +91xxxx
  phonePrint        String? // optional
  address1          String
  address2          String?
  city              String
  state             String
  country           String
  pincode           String // keep as string to avoid issues with leading zeros
  latitude          String? // optional, can be float if you want geospatial queries
  longitude         String? // optional, same note as latitude
  gstNo             String  @unique
  fssaiCode         String? // optional

  active Boolean @default(true)

  // Relation with vendor
  vendorId String        @db.ObjectId
  vendor   VendorProfile @relation(fields: [vendorId], references: [id])

  // Relation with  Warehouse stock
  warehouseStocks      WarehouseStock[]
  warehouseComboStocks WarehouseComboStock[]

  // opposite relation: shipments associated with this warehouse
  shipments Shipment[]

  // For syncing with Shipway
  shipwayWarehouseId String? // store Shipway's ID if you want to track sync status
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WarehouseStock {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String         @db.ObjectId

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String    @db.ObjectId

  productCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productVariantId, warehouseId]) // each variant can only have one stock record per warehouse
}

model WarehouseComboStock {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productCombo   ProductCombo @relation(fields: [productComboId], references: [id])
  productComboId String       @db.ObjectId

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String    @db.ObjectId

  comboCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productComboId, warehouseId]) // each combo can only have one stock record per warehouse
}
