type FAQ {
  question String
  answer   String
}

enum Certification {
  ORGANIC_CERTIFIED
  VEGAN
  NON_GMO
  GLUTEN_FREE
  CRUELTY_FREE
  PARABEN_FREE
}

enum ProductStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  visitCount Int @default(0)
  orderCount Int @default(0)

  name          String
  brandId       String   @db.ObjectId
  tags          String[]
  hsnId         String   @db.ObjectId
  originCountry String

  description         String
  ingredients         String
  healthBenefits      String
  usageInstructions   String
  storageInstructions String

  certifications    Certification[]
  thumbnailImageUrl String
  imageUrls         String[]
  videoUrl          String?
  attributes        String[]
  active            Boolean         @default(true)
  featured          Boolean         @default(false)
  //Created by id
  createdById       String?         @db.ObjectId
  createdBy         VendorProfile?  @relation(fields: [createdById], references: [id])
  productStatus     ProductStatus?  @default(PENDING)
  rejectionReason   String?

  brand Brand     @relation(fields: [brandId], references: [id])
  hsn   HsnConfig @relation(fields: [hsnId], references: [id])

  varients ProductVariant[]
  combos   ProductCombo[]
  reviews  Review[]

  createdAt     DateTime       @default(now())
  notifications Notification[]
}

model ProductCombo {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name          String
  description   String
  imageUrl      String
  active        Boolean @default(true)
  weightInGrams Int     @default(0)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseStocks WarehouseComboStock[]

  items               ComboItem[]
  inclduedInCartItems CartItem[]
  prices              Price[]
  wishlisted          WishlistItem[]

  createdAt DateTime @default(now())
}

model ComboItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quantity Int

  productComboId   String         @db.ObjectId
  productCombo     ProductCombo   @relation(fields: [productComboId], references: [id], onDelete: Cascade)
  productVariantId String         @db.ObjectId
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model ProductVariant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  active             Boolean  @default(true)
  discountPercentage Int      @default(0)
  mfgDate            DateTime
  expiryDate         DateTime
  pricePerGram       Float    @default(0)
  weightInGrams      Int      @default(0)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String  @db.ObjectId
  variant   Variant @relation(fields: [variantId], references: [id])

  partOfCombos ComboItem[]
  wishilisted  WishlistItem[]

  prices          Price[]
  cartItems       CartItem[]
  // sku
  // New relation for per-warehouse stock
  warehouseStocks WarehouseStock[]

  @@unique([productId, variantId])
}

model Price {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  price           Int
  discountedPrice Int     @default(0)
  active          Boolean @default(true)

  productVariantId String?         @db.ObjectId
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  productComboId String?       @db.ObjectId
  productCombo   ProductCombo? @relation(fields: [productComboId], references: [id])

  includedInOrderItems OrderItem[]

  createdAt DateTime @default(now())
}

model Review {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  rating   Int
  message  String
  imageUrl String?
  approved Boolean @default(false)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdById String          @db.ObjectId
  createdBy   CustomerProfile @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  userId String? @db.ObjectId
  User   User?   @relation(fields: [userId], references: [id])
}

model Brand {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name        String  @unique
  description String?
  imageUrl    String?
  active      Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
}
